# Python
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/

# Test and type caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# The mutation audit's breadcrumb: present only while it is rewriting a
# tracked file in place. See CLAUDE.md rule 3.
.mutation-in-flight

# Model weights -- Qwen3.5-4B-Q4_K_M is ~2.6 GB and is not committed
*.gguf
models/

# Local databases produced by running the runtime
*.sqlite
*.sqlite3
*.db

# Environment
.env
.env.*
!.env.example

# OS / editor
.DS_Store
*.pem
.vscode-test

# NOTE: deliberately NOT ignoring "logs" or "*.log".
# The previous Node .gitignore did, which silently swallowed committed
# audit evidence. Raw run output is evidence here and belongs in git --
# see personal-ai/eval/evidence/.
