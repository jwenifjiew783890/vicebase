  {
    "id": "E03",
    "category": "english/topic-change",
    "session": "s",
    "turns": [
      {
        "user": "explain what a mutex is",
        "ai": "A mutex (mutual exclusion lock) is a synchronization primitive that ensures only one thread can access a shared resource at a time. It works by locking the resource when a thread tries to enter a critical section and unlocking it when the thread exits; if another thread tries to lock it while it's already held, that thread blocks or waits until the first thread releases it. This prevents race conditions and data corruption in multi-threaded programs.",
        "route": "fast",
        "lang": "en",
        "ack": "",
        "injected": 0,
        "actions": [],
        "pending": [],
        "ttft_ms": 7969.67240199956,
